<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="stylesheet" href="../public/stylesheets/style.css" />
    <link href="../public/stylesheets/style.css" media="screen and (min-width: 512px) and (max-width: 1024px)" rel="stylesheet">
    <title><%= title%></title>
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
    <link rel="stylesheet" href="/public/stylesheets/typography.css" />
      <link rel="icon" href="/favicon.ico" sizes="any">
      <link rel="icon" href="/public/images/icon/favicon.svg" type="image/svg+xml">
      <link rel="apple-touch-icon" href="/public/images/icon/apple-touch-icon.png">
    <script>
      // 시작 화면에서 "가입하지 않고 이용하기"로(page-transition.js 전환을 거쳐) 넘어온 경우에만 입장 효과를 켠다.
      // 배경(최상단 이미지 · 내비게이션 띠)은 전환의 마지막 장면과 같으므로 그대로 두고, 글과 카드만 차례로 드러낸다.
      // 첫 화면이 그려지기 전에 클래스를 붙여야 내용이 먼저 보였다 사라지지 않는다.
      (function () {
        try {
          if (sessionStorage.getItem("main_transition") !== "1") return;
          sessionStorage.removeItem("main_transition");
          if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
          document.documentElement.classList.add("main-enter");
          var preload = document.createElement("link");
          preload.rel = "preload";
          preload.as = "image";
          preload.href = "/public/images/wall2.png";
          document.head.appendChild(preload);
        } catch (e) {}
      })();
    </script>
  </head>
  <style>
    body {
      margin: 0px;
      animation: fadein 1000ms ease-out;
      background-color: white;
    }
  </style>
  <body>
    <%- include('main_nav.ejs')%>
    <%- include(page) %>
    <script>
      // 입장 효과가 끝나면 클래스를 뗀다 (main-entered 는 본문 fadein 이 다시 걸리지 않도록 남겨 둔다)
      if (document.documentElement.classList.contains("main-enter")) {
        setTimeout(function () {
          document.documentElement.classList.add("main-entered");
          document.documentElement.classList.remove("main-enter");
        }, 1600);
      }
    </script>
  </body>
</html>
