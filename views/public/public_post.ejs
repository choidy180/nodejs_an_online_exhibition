<%
    // 공지사항 글 — 메인 화면 스타일
    var post = row[0];
    var author = row2 && row2[0];
%>
<style>
    body {
        background-color: #141414;
    }
</style>
<main class="mp mp--narrow" aria-labelledby="mp_title">
    <a class="mp_back" href="/public">공지사항 목록</a>
    <header class="mp_head mp_head--post">
        <div class="mp_head_text">
            <p class="mp_kicker"><span>NOTICE</span><span>No.<%= post.NUMBER %></span></p>
            <h1 class="mp_title mp_title--post" id="mp_title"><%= post.TITLE %></h1>
            <div class="np_meta">
                <span class="np_avatar" aria-hidden="true">
                    <% if (author && author.IMG) { %>
                        <img src="/uploads/<%= author.IMG %>" alt="">
                    <% } else { %>
                        <%= String(post.USER_ID || "?").charAt(0).toUpperCase() %>
                    <% } %>
                </span>
                <span class="np_author"><%= post.USER_ID %></span>
                <span><%= register_date[0] %></span>
                <span>조회 <%= post.HIT %></span>
            </div>
        </div>
    </header>
    <div class="np_body"><%= post.CONTENT %></div>
    <div class="np_foot">
        <a class="mp_button" href="/public">목록으로</a>
    </div>
</main>
