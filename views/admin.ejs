<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="stylesheet" href="../public/stylesheets/style.css" />
    <link href="../public/stylesheets/style.css" media="screen and (min-width: 512px) and (max-width: 1024px)" rel="stylesheet">
    <title><%= title%></title>
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
    <link rel="stylesheet" href="/public/stylesheets/typography.css" />
  </head>
  <style>
    body {
      margin: 0px;
      animation: fadein 1000ms ease-out;
      background-color: white;
    }
  </style>
  <body>
    <%- include('main_nav.ejs')%>
    <div class="app_for_exhibition_area">
        <div class="app_for_exhibition_container">
            <div class="app_for_exhibition_container_left">
                <div class="app_for_exhibition_user_info">
                    <div class="afe_user_info_imgbox">
                        <img class="afe_user_info_img" src="/uploads/<%=sess.user.IMG%>" alt="">
                    </div>
                    <p class="afe_user_info_name"><%= sess.user.NAME%></p>
                    <p class="afe_user_info_name" style="font-weight: 500; letter-spacing: var(--ls-body);"><%= sess.user.EMAIL%></p>
                </div>
                <div class="app_for_exhibition_user_info_bottom">
                    <p class="app_for_exhibition_user_info_bottom_text" onclick="location.href='/exhibition_approval'">전시회 승인/거절</p>
                    <p class="app_for_exhibition_user_info_bottom_text" onclick="location.href='/approval_exhibition_yeslist'">승인한 전시회</p>
                    <p class="app_for_exhibition_user_info_bottom_text" style="margin-top: -10px;"onclick="location.href='/approval_exhibition_nolist'">거절한 전시회</p>
                    <p class="app_for_exhibition_user_info_bottom_text" onclick="location.href='/exhibition_payment_list'">전시회 결제 리스트</p>
                    <p class="app_for_exhibition_user_info_bottom_text" onclick="location.href='/inquiry_answer'">문의 답변</p>
                </div>
            </div>
            <%- include(page) %>
        </div>
    </div>
  </body>
</html>
