<%
    // 작품 지원 · 전시회 상세 — 전시회 상세(exhibition_detail.ejs)와 같은 틀
    var ex = row[0];
    var works = row2 || [];
    var DAY = 24 * 60 * 60 * 1000;
    var today = new Date();
    var IMG_DIR = "/public/images/exhibition_title_images/";

    function pad(n) { return String(n).padStart(2, "0"); }
    function ymd(value) {
        var d = new Date(value);
        if (isNaN(d)) return "";
        return d.getFullYear() + "." + pad(d.getMonth() + 1) + "." + pad(d.getDate());
    }

    var booths = Number(ex.BOOTH_COUNT) || 0;
    var taken = works.length;
    var left = Math.max(0, booths - taken);
    var deadlineAt = ex.DEADLINE ? new Date(ex.DEADLINE) : null;
    var deadlinePassed = !!(deadlineAt && today > deadlineAt);
    var full = booths > 0 && taken >= booths;
    var open = !deadlinePassed && !full;
    var days = deadlineAt ? Math.ceil((deadlineAt - today) / DAY) : null;
    var status = deadlinePassed ? "모집 마감" : full ? "부스 마감" : "모집 중";
    var dday = open && days !== null ? (days > 0 ? "D-" + days : "오늘 마감") : "";
    var category = !ex.DETAIL_CATEGORY || ex.DETAIL_CATEGORY === ex.CATEGORY
        ? ex.CATEGORY
        : ex.CATEGORY + " / " + ex.DETAIL_CATEGORY;
%>
<style>
    body {
        background-color: #141414;
    }
</style>
<article class="xd" aria-labelledby="xd_title">
    <header class="xd_hero">
        <img class="xd_hero_bg" src="<%= IMG_DIR + ex.IMG %>" alt="" aria-hidden="true">
        <div class="xd_hero_inner">
            <div class="xd_hero_text">
                <a class="mp_back xd_back" href="/supportable_exhibition">작품 지원 목록</a>
                <p class="xd_kicker">
                    <span>SUPPORT</span>
                    <span><%= status %></span>
                    <% if (dday) { %><span><%= dday %></span><% } %>
                </p>
                <h1 class="xd_title" id="xd_title"><%= ex.TITLE %></h1>
                <dl class="xd_meta">
                    <div>
                        <dt>모집 마감</dt>
                        <dd><%= ymd(ex.DEADLINE) %></dd>
                    </div>
                    <div>
                        <dt>전시 기간</dt>
                        <dd><%= ymd(ex.START_TIME) %> — <%= ymd(ex.END_TIME) %></dd>
                    </div>
                    <div>
                        <dt>주최</dt>
                        <dd><%= ex.USER_ID %></dd>
                    </div>
                </dl>
                <div class="xd_actions">
                    <% if (open) { %>
                        <% if (sess.user) { %>
                            <a class="xd_button" href="/exhibition_support_registration/<%= ex.NUMBER %>">작품 등록</a>
                        <% } else { %>
                            <a class="xd_button" href="/login">로그인하고 지원</a>
                        <% } %>
                    <% } else { %>
                        <p class="xd_closed"><%= full ? "모든 부스가 찼습니다." : "모집이 마감된 전시회입니다." %></p>
                    <% } %>
                    <% if (category) { %><span class="xd_category"><%= category %></span><% } %>
                </div>
            </div>
            <figure class="xd_poster">
                <img src="<%= IMG_DIR + ex.IMG %>" alt="<%= ex.TITLE %> 포스터">
            </figure>
        </div>
    </header>

    <div class="xd_body">
        <section class="xd_stats" aria-label="모집 정보">
            <div class="xd_stat">
                <p class="xd_stat_label">BOOTHS</p>
                <p class="xd_stat_value"><%= booths %></p>
            </div>
            <div class="xd_stat">
                <p class="xd_stat_label">APPLIED</p>
                <p class="xd_stat_value"><%= taken %></p>
            </div>
            <div class="xd_stat">
                <p class="xd_stat_label">REMAINING</p>
                <p class="xd_stat_value"><%= left %><small> / <%= booths %></small></p>
            </div>
            <div class="xd_stat">
                <p class="xd_stat_label">DEADLINE</p>
                <p class="xd_stat_value"><%= dday || "마감" %></p>
            </div>
        </section>

        <section class="xd_section" aria-labelledby="xd_about_title">
            <h2 class="xd_section_title" id="xd_about_title">ABOUT</h2>
            <div class="xd_about"><%= ex.EXPLAIN_TEXT %></div>
            <p class="xd_note">부스 수만큼 작품을 받습니다. 부스가 모두 차거나 마감일이 지나면 모집이 끝납니다.</p>
        </section>
    </div>
</article>
