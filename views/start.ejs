<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <link rel="stylesheet" href="/public/stylesheets/tokens.css">
    <link rel="stylesheet" href="/public/stylesheets/intro.css">
    <title>온라인 전시회 플랫폼</title>
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
    <link rel="stylesheet" href="/public/stylesheets/typography.css" />
    <link rel="preload" href="/public/images/start/start5.png" as="image">
    <script>
        // 인트로의 전환 효과(intro-stage.js)를 거쳐 넘어온 경우에만 입장 효과를 켠다.
        // 배경은 인트로 캔버스의 마지막 프레임과 같으므로 그대로 두고, 로고/버튼만 드러낸다.
        // 첫 화면이 그려지기 전에 클래스를 붙여야 로고/버튼이 먼저 보였다 사라지지 않는다.
        (function () {
            try {
                if (sessionStorage.getItem("stage_transition") !== "1") return;
                sessionStorage.removeItem("stage_transition");
                if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
                document.documentElement.classList.add("stage-enter");
            } catch (e) {}
        })();
    </script>
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" href="/public/images/icon/favicon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/public/images/icon/apple-touch-icon.png">
</head>
<body>
    <div class="background" id="back1" style="background: url(/public/images/start/start5.png) center center / cover no-repeat; filter: brightness(20%);">
    </div>
    <!-- 메인 화면 스타일: 반투명 검정 패널 + 1px 선 + 가는 글씨, 빨강은 마우스를 올렸을 때만 -->
    <main class="start_stage">
        <section class="start_panel" aria-labelledby="start_title">
            <p class="start_kicker">WELCOME</p>
            <h1 class="start_logo_wrap" id="start_title">
                <a href="/" aria-label="EXHIBITION — 인트로로 돌아가기">
                    <img class="start_logo" src="/public/images/icon/exhibition_logo.svg" alt="EXHIBITION">
                </a>
            </h1>
            <p class="start_desc">
                언제 어디서든 전시회를 관람하고,<br>
                나만의 전시회를 열어 보세요.
            </p>
            <div class="start_actions">
                <a class="mono_btn" href="/sign_first">회원가입 하기</a>
                <a class="mono_btn" href="/main" data-page-transition="main">가입하지 않고 이용하기</a>
            </div>
            <p class="start_divider">기존 회원은 로그인 후 이용하세요</p>
            <a class="mono_btn mono_btn--solid" href="/login" data-page-transition="login">로그인</a>
        </section>
    </main>
    <script>
        // 입장 효과가 끝나면 클래스를 떼서 clip-path가 남지 않게 한다
        if (document.documentElement.classList.contains("stage-enter")) {
            setTimeout(function () {
                document.documentElement.classList.remove("stage-enter");
            }, 900);
        }
    </script>
    <script src="/public/javascripts/page-transition.js"></script>
    <script>
        // 가입하지 않고 이용하기 → 메인, 로그인 → 로그인 화면:
        // 패널이 걷히는 동안 반짝이는 원형 디졸브로 다음 화면 첫 장면까지 넘어간 뒤 이동한다
        // (효과 본체: page-transition.js / 도착한 화면은 flag 를 보고 글과 버튼만 차례로 드러낸다)
        (function () {
            var START_BACKGROUND = "/public/images/start/start5.png";
            var START_BRIGHTNESS = 0.2; // #back1: filter: brightness(20%)
            var PANEL_OUT_MS = 420;     // WebGL을 못 쓸 때는 패널이 걷힌 뒤 바로 이동
            // 다음 화면의 첫 장면. 값은 각 화면의 배경과 똑같아야 이음매가 안 보인다
            var DESTINATIONS = {
                main: {  // style.css .top_main_area
                    to: "/public/images/wall2.png",
                    toLayout: "main",
                    flag: "main_transition"
                },
                login: { // views/user/login.ejs #back1
                    to: "/public/images/start/login.jpg",
                    toLayout: "cover",
                    toBrightness: 0.2,
                    flag: "stage_transition"
                }
            };

            var links = document.querySelectorAll("[data-page-transition]");
            var reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
            var leaving = false;
            var fallbackTimer = null;

            Array.prototype.forEach.call(links, function (link) {
                var dest = DESTINATIONS[link.getAttribute("data-page-transition")];
                if (!dest) return;
                link.addEventListener("click", function (event) {
                    // 새 탭 열기(Ctrl/⌘/Shift/가운데 버튼)는 그대로 둔다
                    if (event.button !== 0 || event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
                    if (reduceMotion || !window.PageTransition) return;
                    event.preventDefault();
                    if (leaving) return;
                    leaving = true;
                    var href = link.getAttribute("href");
                    try {
                        sessionStorage.setItem(dest.flag, "1");
                    } catch (e) {}
                    document.body.classList.add("is-leaving");

                    function go() {
                        location.href = href;
                    }
                    window.PageTransition.play({
                        from: START_BACKGROUND,
                        fromBrightness: START_BRIGHTNESS,
                        to: dest.to,
                        toLayout: dest.toLayout,
                        toBrightness: dest.toBrightness,
                        duration: 1700
                    }).then(go, function () {
                        fallbackTimer = setTimeout(go, PANEL_OUT_MS);
                    });
                });
            });

            window.addEventListener("load", function () {
                if (!window.PageTransition) return;
                var urls = [START_BACKGROUND];
                Object.keys(DESTINATIONS).forEach(function (key) {
                    urls.push(DESTINATIONS[key].to);
                });
                window.PageTransition.preload(urls);
            });

            // 뒤로가기로 bfcache 에서 복원되면 원래 상태로
            window.addEventListener("pageshow", function (event) {
                if (!event.persisted) return;
                clearTimeout(fallbackTimer);
                leaving = false;
                if (window.PageTransition) window.PageTransition.reset();
                document.body.classList.remove("is-leaving");
            });
        })();
    </script>
</body>
</html>