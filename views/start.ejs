<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <link rel="stylesheet" href="/public/stylesheets/intro.css">
    <title>온라인 전시회 플랫폼</title>
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
    <link rel="stylesheet" href="/public/stylesheets/typography.css" />
    <link rel="preload" href="/public/images/start/start5.png" as="image">
    <script>
        // 인트로의 전환 효과(stage-transition.js)를 거쳐 넘어온 경우에만 입장 효과를 켠다.
        // 배경은 인트로 캔버스의 마지막 프레임과 같으므로 그대로 두고, 로고/버튼만 드러낸다.
        // 첫 화면이 그려지기 전에 클래스를 붙여야 로고/버튼이 먼저 보였다 사라지지 않는다.
        (function () {
            try {
                if (sessionStorage.getItem("stage_transition") !== "1") return;
                sessionStorage.removeItem("stage_transition");
                if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
                document.documentElement.classList.add("stage-enter");
            } catch (e) {}
        })();
    </script>
</head>
<body>
    <div class="background" id="back1" style="background: url(/public/images/start/start5.png) center center / cover no-repeat; filter: brightness(20%);">
    </div>
    <div class="intro_content_box" style="margin-top: -65vh;">
        <div class="start_logo_box">
            <img class="start_logo" src="/public/images/icon/exhibition_logo.svg" alt="EXHIBITION" style="cursor: pointer;" onclick="location.href='/'">
        </div>
        <div class="start_button_box">
            <button class="start_button" onclick="location.href='/sign_first'">회원가입 하기</button>
        </div>
        <div class="start_button_box">
            <button class="start_button" onclick="location.href='/main'">가입하지 않고 이용하기</button>
        </div>
        <div class="start_button_box">
            <div style="width: 12vw; background-color: lightgrey; height: 1px; filter: brightness(50%);"></div>
        </div>
        <div class="start_button_box" style="margin-bottom: -1vh;">
            <span style="font-size: 14px; filter: brightness(50%);">기존회원은 로그인후에 이용하세요</span>
        </div>    
        <div class="start_button_login_box">
            <button class="start_login_button" onclick="location.href='/login'">로그인</button>
        </div>
    </div>
    <script>
        // 입장 효과가 끝나면 클래스를 떼서 clip-path가 남지 않게 한다
        if (document.documentElement.classList.contains("stage-enter")) {
            setTimeout(function () {
                document.documentElement.classList.remove("stage-enter");
            }, 900);
        }
    </script>
</body>
</html>