<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <link rel="stylesheet" href="/public/stylesheets/tokens.css">
    <link rel="stylesheet" href="/public/stylesheets/intro.css">
    <title>온라인 전시회 플랫폼</title>
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
    <link rel="stylesheet" href="/public/stylesheets/typography.css" />
    <script>
        // 타이핑 스크립트(intro-typing.js)가 제목을 비우기 전에 완성된 문구가 잠깐 보이지 않도록 숨겨 둔다.
        // 스크립트가 준비를 마치면(실패해도) 이 클래스를 뗀다.
        document.documentElement.classList.add("typing-pending");
    </script>
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" href="/public/images/icon/favicon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/public/images/icon/apple-touch-icon.png">
</head>
<body>
    <div class="background" id="back1" data-stage-image="/public/images/start/1.jpg" data-stage-brightness="0.3" style="background-image: url(/public/images/start/1.jpg); filter: brightness(30%);">
    </div>
    <div class="intro_content_box">
        <p class="intro_kicker">01 / 04</p>
        <p class="intro_content_title"><span class="intro_label">평소에 보고싶었지만 가지 못했던 전시회가 있나요</span></p>
        <p class="intro_content_sub_title"><span class="intro_label">언제 어디서든 편안하게 전시회를 관람하세요</span></p>
        <div class="intro_content_button_box">
            <button type="button" class="intro_content_button" data-href="/start">전시회 관람하기</button>
        </div>
        <button type="button" class="scroll_cue" onclick="scroll_1()" aria-label="다음 화면으로 이동"><span class="scroll_cue_mouse"><span class="scroll_cue_wheel"></span></span><span class="scroll_cue_arrows"><i></i><i></i></span><span class="scroll_cue_label">SCROLL</span></button>
    </div>
    <div class="background" id="back2" data-stage-image="/public/images/start/intro_archive.jpg" data-stage-brightness="0.42" style="background-image: url(/public/images/start/intro_archive.jpg); filter: brightness(42%);">
    </div>
    <div class="intro_content_box">
        <p class="intro_kicker">02 / 04</p>
        <p class="intro_content_title"><span class="intro_label">이미 끝났지만 보고 싶었던 전시회가 있나요</span></p>
        <p class="intro_content_sub_title"><span class="intro_label">언제든지 저렴한 가격으로 보고싶었던 전시회를 관람하세요</span></p>
        <div class="intro_content_button_box">
            <button type="button" class="intro_content_button" data-href="/start">지난 전시회 보기</button>
        </div>
        <button type="button" class="scroll_cue" onclick="scroll_2()" aria-label="다음 화면으로 이동"><span class="scroll_cue_mouse"><span class="scroll_cue_wheel"></span></span><span class="scroll_cue_arrows"><i></i><i></i></span><span class="scroll_cue_label">SCROLL</span></button>
    </div>
    <div class="background" id="back3" data-stage-image="/public/images/start/intro_gallery.jpg" data-stage-brightness="0.5" style="background-image: url(/public/images/start/intro_gallery.jpg); filter: brightness(50%);">
    </div>
    <div class="intro_content_box">
        <p class="intro_kicker">03 / 04</p>
        <p class="intro_content_title"><span class="intro_label">나만의 전시회를 차려보고 싶진 않나요</span></p>
        <p class="intro_content_sub_title"><span class="intro_label">당신만의 전시회를 개최해 보세요</span></p>
        <div class="intro_content_button_box">
            <button type="button" class="intro_content_button" data-href="/start">전시회 개최하기</button>
        </div>
        <button type="button" class="scroll_cue" onclick="scroll_3()" aria-label="다음 화면으로 이동"><span class="scroll_cue_mouse"><span class="scroll_cue_wheel"></span></span><span class="scroll_cue_arrows"><i></i><i></i></span><span class="scroll_cue_label">SCROLL</span></button>
    </div>
    <div class="background" id="back4" data-stage-image="/public/images/start/intro_fluid.jpg" data-stage-brightness="0.35" style="background-image: url(/public/images/start/intro_fluid.jpg); filter: brightness(35%);">
    </div>
    <div class="intro_content_box">
        <p class="intro_kicker">04 / 04</p>
        <p class="intro_content_title"><span class="intro_label">저렴한 금액으로 전시회를 관람하세요</span></p>
        <p class="intro_content_sub_title"><span class="intro_label">보고 싶은 전시회를 마음껏 관람하세요</span></p>
        <div class="intro_content_button_box">
            <button type="button" class="intro_content_button" data-href="/start">작품 관람하기</button>
        </div>
        <button type="button" class="scroll_cue scroll_cue--top" onclick="scroll_4()" aria-label="처음 화면으로 이동"><span class="scroll_cue_mouse"><span class="scroll_cue_wheel"></span></span><span class="scroll_cue_arrows"><i></i><i></i></span><span class="scroll_cue_label">TOP</span></button>
        <script>
            // 스크롤 이동: 배경 캔버스(intro-stage.js)가 있으면 천천히 스크롤하며 이미지가 디졸브된다
            function scrollToSection(index) {
                if (window.IntroStage) {
                    window.IntroStage.scrollToSection(index);
                } else {
                    window.scrollTo(0, document.querySelectorAll(".background")[index].offsetTop);
                }
            }
            scroll_1 = () => scrollToSection(1);
            scroll_2 = () => scrollToSection(2);
            scroll_3 = () => scrollToSection(3);
            // TOP: 3 → 2 → 1 을 거치지 않고 맨 위 이미지로 한 번에 디졸브
            scroll_4 = () => {
                if (window.IntroStage) {
                    window.IntroStage.jumpToSection(0);
                } else {
                    window.scrollTo(0, 0);
                }
            };
        </script>
    </div>
    <!-- 메인 화면과 같은 내비게이션 바: 반투명 검정, 로고 + 가는 글씨 링크 -->
    <header class="intro_nav intro_fixed">
        <a class="intro_nav_logo" href="/"><img src="/public/images/icon/exhibition_logo.svg" alt="EXHIBITION"></a>
        <a class="intro_nav_link" href="/login" data-stage-leave>LOGIN</a>
    </header>
    <script src="/public/javascripts/intro-typing.js"></script>
    <script src="/public/javascripts/intro-stage.js"></script>
    <script>
        // 인트로 → 시작 페이지(버튼들) · 로그인 화면(오른쪽 위 LOGIN) 전환
        // 문구/버튼이 블록 단위로 걷히는 동안, 배경 캔버스(intro-stage.js)가 반짝이는 원형 디졸브로
        // 다음 화면 배경까지 넘어간 뒤 이동한다. 움직임은 끝에서 0이 되어 다음 화면 배경과 똑같이 끝난다
        // (도착한 화면은 stage_transition 표시를 보고 글과 버튼만 차례로 드러낸다)
        (function () {
            // 값은 각 화면 #back1 배경과 반드시 같아야 이동 순간이 이어져 보인다
            var DESTINATIONS = {
                "/start": { background: "/public/images/start/start5.png", brightness: 0.2 }, // start.ejs
                "/login": { background: "/public/images/start/login.jpg", brightness: 0.2 }   // user/login.ejs
            };
            var TEXT_OUT_MS = 420;      // WebGL을 못 쓸 때는 문구가 걷힌 뒤 바로 이동

            var leaving = false;
            var fallbackTimer = null;
            var reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

            function leaveTo(href) {
                if (leaving) return;
                var dest = DESTINATIONS[href];
                if (reduceMotion || !dest) {
                    location.href = href;
                    return;
                }
                leaving = true;
                try {
                    sessionStorage.setItem("stage_transition", "1");
                } catch (e) {}
                document.body.classList.add("is-leaving");

                function go() {
                    location.href = href;
                }
                function goAfterTextOut() {
                    fallbackTimer = setTimeout(go, TEXT_OUT_MS);
                }

                if (!window.IntroStage) {
                    goAfterTextOut();
                    return;
                }
                window.IntroStage.leave(dest.background, dest.brightness, 1700).then(go, goAfterTextOut);
            }

            document.querySelectorAll(".intro_content_button[data-href]").forEach(function (button) {
                button.addEventListener("click", function () {
                    leaveTo(button.getAttribute("data-href"));
                });
            });

            document.querySelectorAll("a[data-stage-leave]").forEach(function (link) {
                link.addEventListener("click", function (event) {
                    // 새 탭 열기(Ctrl/⌘/Shift/가운데 버튼)는 그대로 둔다
                    if (event.button !== 0 || event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
                    event.preventDefault();
                    leaveTo(link.getAttribute("href"));
                });
            });

            // 다음 배경을 미리 받아 둔다
            window.addEventListener("load", function () {
                if (!window.IntroStage) return;
                window.IntroStage.preload(Object.keys(DESTINATIONS).map(function (href) {
                    return DESTINATIONS[href].background;
                }));
            });

            // 뒤로가기로 bfcache에서 복원되면 퇴장 상태를 되돌린다 (캔버스 쪽은 intro-stage.js 가 되돌린다)
            window.addEventListener("pageshow", function (event) {
                if (!event.persisted) return;
                clearTimeout(fallbackTimer);
                leaving = false;
                document.body.classList.remove("is-leaving");
            });
        })();
    </script>
</body>
</html>