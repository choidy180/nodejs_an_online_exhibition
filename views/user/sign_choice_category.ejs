<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/public/stylesheets/tokens.css">
    <link rel="stylesheet" href="/public/stylesheets/intro.css">
    <title>카테고리 선택</title>
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
    <link rel="stylesheet" href="/public/stylesheets/typography.css" />
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" href="/public/images/icon/favicon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/public/images/icon/apple-touch-icon.png">
</head>
<body>
    <div class="background" id="back1" style="background: url(/public/images/start/start5.png) center center / cover no-repeat; filter: brightness(20%);">
    </div>
    <!-- 회원가입 3단계 — 로그인/시작 화면과 같은 메인 스타일 패널 (카테고리가 많아 넓은 패널) -->
    <main class="start_stage">
        <form class="start_panel start_panel--wide" action="/board/category_register" method="POST" aria-labelledby="signup_title">
            <p class="start_kicker">SIGN UP — 03 / 03</p>
            <h1 class="signup_title" id="signup_title">관심 카테고리 선택</h1>
            <p class="start_desc"><strong class="signup_user"><%= id %></strong> 님, 좋아하는 카테고리를 3개 골라 주세요.</p>
            <ol class="signup_progress" aria-label="회원가입 단계">
                <li class="is-done">기본 정보</li>
                <li class="is-done">추가 정보</li>
                <li class="is-current" aria-current="step">관심 카테고리</li>
            </ol>

            <% if (row && row.length) { %>
                <div class="category_grid">
                    <% row.forEach(function (category) { %>
                        <button type="button" class="category_tile" data-name="<%= category.NAME %>" aria-pressed="false">
                            <img src="/category_img/<%= category.IMG %>" alt="" loading="lazy">
                            <span class="category_tile_name"><%= category.NAME %></span>
                            <span class="category_tile_badge" aria-hidden="true"></span>
                        </button>
                    <% }) %>
                </div>
            <% } else { %>
                <p class="category_empty">카테고리를 불러오지 못했습니다. 잠시 후 다시 시도해 주세요.</p>
            <% } %>

            <!-- 고른 카테고리 3개 (서버가 category1 배열로 받는다) -->
            <input type="hidden" name="category1" class="category_value">
            <input type="hidden" name="category1" class="category_value">
            <input type="hidden" name="category1" class="category_value">

            <div class="category_footer">
                <p class="category_count" id="category_count" aria-live="polite">0 / 3 선택</p>
                <button type="submit" class="mono_btn mono_btn--solid category_submit" id="category_submit" disabled>카테고리 등록</button>
            </div>
        </form>
    </main>
    <a class="signup_home" href="/" aria-label="EXHIBITION — 인트로로">
        <img src="/public/images/icon/exhibition_logo.svg" alt="EXHIBITION">
    </a>
    <script>
        // 카테고리 고르기: 누르면 선택/해제, 최대 3개, 고른 순서대로 1·2·3 표시
        (function () {
            var MAX = 3;
            var selected = [];
            var tiles = document.querySelectorAll(".category_tile");
            var values = document.querySelectorAll(".category_value");
            var count = document.getElementById("category_count");
            var submit = document.getElementById("category_submit");

            function render() {
                tiles.forEach(function (tile) {
                    var order = selected.indexOf(tile.getAttribute("data-name"));
                    tile.setAttribute("aria-pressed", order >= 0 ? "true" : "false");
                    tile.querySelector(".category_tile_badge").textContent = order >= 0 ? order + 1 : "";
                    tile.classList.toggle("is-locked", order < 0 && selected.length >= MAX);
                });
                values.forEach(function (input, i) {
                    input.value = selected[i] || "";
                });
                count.textContent = selected.length + " / " + MAX + " 선택";
                submit.disabled = selected.length !== MAX;
            }

            tiles.forEach(function (tile) {
                tile.addEventListener("click", function () {
                    var name = tile.getAttribute("data-name");
                    var i = selected.indexOf(name);
                    if (i >= 0) {
                        selected.splice(i, 1);
                    } else if (selected.length < MAX) {
                        selected.push(name);
                    }
                    render();
                });
            });
            render();
        })();
    </script>
</body>
</html>
