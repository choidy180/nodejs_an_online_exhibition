<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <link rel="stylesheet" href="/public/stylesheets/tokens.css">
    <link rel="stylesheet" href="/public/stylesheets/intro.css">
    <title>로그인</title>
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
    <link rel="stylesheet" href="/public/stylesheets/typography.css" />
    <link rel="preload" href="/public/images/start/login.jpg" as="image">
    <script>
        // 시작 화면의 로그인 버튼(page-transition.js 전환)을 거쳐 넘어온 경우에만 입장 효과를 켠다.
        // 배경은 전환의 마지막 장면과 같으므로 그대로 두고, 패널의 글과 입력칸만 차례로 드러낸다.
        // 첫 화면이 그려지기 전에 클래스를 붙여야 패널이 먼저 보였다 사라지지 않는다.
        (function () {
            try {
                if (sessionStorage.getItem("stage_transition") !== "1") return;
                sessionStorage.removeItem("stage_transition");
                if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
                document.documentElement.classList.add("stage-enter");
            } catch (e) {}
        })();
    </script>
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" href="/public/images/icon/favicon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/public/images/icon/apple-touch-icon.png">
</head>
<body>
    <div class="background" id="back1" style="background: url(/public/images/start/login.jpg) center center / cover no-repeat; filter: brightness(20%);">
    </div>
    <!-- 시작 화면과 같은 메인 스타일 패널: 반투명 검정 + 1px 선 + 가는 글씨, 빨강은 마우스를 올렸을 때만 -->
    <main class="start_stage">
        <form class="start_panel" action="/users/login_user" method="POST" aria-labelledby="login_title">
            <p class="start_kicker">LOGIN</p>
            <h1 class="start_logo_wrap" id="login_title">
                <a href="/main" aria-label="EXHIBITION — 메인으로">
                    <img class="start_logo" src="/public/images/icon/exhibition_logo.svg" alt="EXHIBITION">
                </a>
            </h1>
            <p class="start_desc">
                다시 오신 것을 환영합니다.<br>
                아이디와 비밀번호를 입력해 주세요.
            </p>
            <div class="login_fields">
                <label class="sr_only" for="login_id">아이디</label>
                <input id="login_id" class="line_input" type="text" name="id" placeholder="아이디" autocomplete="username">
                <label class="sr_only" for="login_pwd">비밀번호</label>
                <input id="login_pwd" class="line_input" type="password" name="pwd" placeholder="비밀번호" autocomplete="current-password">
            </div>
            <button type="submit" class="mono_btn mono_btn--solid login_submit">로그인</button>
            <p class="start_divider">아직 회원이 아니신가요?</p>
            <a class="mono_btn" href="/sign_first">회원가입 하기</a>
        </form>
    </main>
    <script>
        // 입장 효과가 끝나면 클래스를 떼서 clip-path가 남지 않게 한다
        if (document.documentElement.classList.contains("stage-enter")) {
            setTimeout(function () {
                document.documentElement.classList.remove("stage-enter");
            }, 1000);
        }
    </script>
</body>
</html>
