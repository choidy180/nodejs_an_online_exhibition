<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <link rel="stylesheet" href="/public/stylesheets/intro.css">
    <title>로그인</title>
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
    <link rel="stylesheet" href="/public/stylesheets/typography.css" />
</head>
<body>
    <form action="/users/login_user" method="POST">
        <div class="background" id="back1" style="background: url(/public/images/start/login.jpg) center center / cover no-repeat; filter: brightness(20%);">
        </div>
        <div class="login_box">
            <input type="text" class="login_box_input" placeholder="아이디" name="id">
        </div>
        <div class="login_box" style="top: calc(47vh + 55px);">
            <input type="password" class="login_box_input" placeholder="비밀번호" name="pwd">
        </div>
        <div class="login_box" style="top: calc(47vh + 145px);">
            <button class="login_page_login_button">로그인</button>
        </div>
    </form>
    <img src="/public/images/icon/exhibition_logo.svg" alt="EXHIBITION" style="position: fixed; top: 36vh; left: calc(50% - 220px); z-index: 10; width: 440px; cursor: pointer;" onclick="location.href='/main'">
    <button style="position: fixed; top: 20px; right: 20px; z-index: 10; width: 80px; height: 35px; font-size: 16px; border: none; outline: none; border-radius: 17.5px; cursor: pointer;" onclick="location.href='/sign_first'">회원가입</button>
</body>
</html>