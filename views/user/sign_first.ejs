<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <link rel="stylesheet" href="/public/stylesheets/intro.css">
    <title>회원가입</title>
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
    <link rel="stylesheet" href="/public/stylesheets/typography.css" />
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" href="/public/images/icon/favicon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/public/images/icon/apple-touch-icon.png">
</head>
<style>
    body{
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: flex-start;
    }
</style>
<body class="ui--light">
    <div class="sign_box" style="font-size: 30px; font-weight: 700;">
        <span>회원가입</span>
    </div>
    <form action="/users/sign1" method="POST">
        <div class="sign_box" style="margin-top: 5vh;">
            <input id="id" class="ui_input sign_box_input" type="text" placeholder="아이디" name="id">
        </div>
        <div class="sign_box" style="margin-top: 1vh;">
            <input id="pwd" class="ui_input sign_box_input" type="password" placeholder="비밀번호" name="pwd">
        </div>
        <div class="sign_box" style="margin-top: 1vh;">
            <input id="name" class="ui_input sign_box_input" type="text" placeholder="이름" name="name">
        </div>
        <div class="sign_box" style="margin-top: 1vh;">
            <input id="tel" class="ui_input sign_box_input" type="text" placeholder="전화번호" name="tel">
        </div>
        <div class="sign_box" style="margin-top: 3vh;">
            <button class="ui_btn ui_btn--primary sign_submit_button">다음 단계로</button>
        </div>
    </form>
    <img src="/public/images/icon/exhibition_logo.svg" alt="EXHIBITION" style="position: fixed; top: 20px; left: 20px; z-index: 10; width: 240px; cursor: pointer;">
</body>
</html>