<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <link rel="stylesheet" href="/public/stylesheets/tokens.css">
    <link rel="stylesheet" href="/public/stylesheets/intro.css">
    <title>회원가입</title>
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
    <link rel="stylesheet" href="/public/stylesheets/typography.css" />
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" href="/public/images/icon/favicon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/public/images/icon/apple-touch-icon.png">
</head>
<body>
    <div class="background" id="back1" style="background: url(/public/images/start/start5.png) center center / cover no-repeat; filter: brightness(20%);">
    </div>
    <!-- 회원가입 2단계 — 로그인/시작 화면과 같은 메인 스타일 패널 -->
    <main class="start_stage">
        <form class="start_panel" action="/users/sign2" method="POST" enctype="multipart/form-data" aria-labelledby="signup_title">
            <!-- 1단계에서 만든 아이디 (서버가 user_id 로 받는다) -->
            <input type="hidden" name="user_id" value="<%= user_id %>">
            <p class="start_kicker">SIGN UP — 02 / 03</p>
            <h1 class="signup_title" id="signup_title">추가 정보 입력</h1>
            <p class="start_desc"><strong class="signup_user"><%= user_id %></strong> 님, 프로필과 연락처를 입력해 주세요.</p>
            <ol class="signup_progress" aria-label="회원가입 단계">
                <li class="is-done">기본 정보</li>
                <li class="is-current" aria-current="step">추가 정보</li>
                <li>관심 카테고리</li>
            </ol>

            <!-- 프로필 이미지: 고르면 바로 미리보기 (서버가 이미지를 꼭 받아야 해서 필수) -->
            <div class="profile_picker">
                <div class="profile_preview" id="profile_preview" aria-hidden="true">
                    <span>PROFILE</span>
                </div>
                <div class="profile_picker_text">
                    <span class="field_label">프로필 이미지</span>
                    <label for="ex_file" class="mono_btn mono_btn--small">이미지 선택</label>
                    <input type="file" id="ex_file" class="sr_only" accept="image/*" name="userfile" required>
                    <span class="profile_hint" id="profile_hint">JPG · PNG 등 이미지 파일</span>
                </div>
            </div>

            <div class="signup_fields">
                <label class="field">
                    <span class="field_label">이메일</span>
                    <input id="email" class="line_input" type="email" name="email" placeholder="example@email.com" autocomplete="email">
                </label>
                <label class="field">
                    <span class="field_label">출생년도</span>
                    <input id="age" class="line_input" type="text" name="age" placeholder="예) 1998" inputmode="numeric" maxlength="4" autocomplete="bday-year">
                </label>
            </div>
            <button type="submit" class="mono_btn mono_btn--solid signup_submit">가입하기</button>
        </form>
    </main>
    <a class="signup_home" href="/" aria-label="EXHIBITION — 인트로로">
        <img src="/public/images/icon/exhibition_logo.svg" alt="EXHIBITION">
    </a>
    <script>
        // 프로필 이미지를 고르면 미리보기 칸에 보여 준다
        (function () {
            var input = document.getElementById("ex_file");
            var preview = document.getElementById("profile_preview");
            var hint = document.getElementById("profile_hint");
            input.addEventListener("change", function () {
                var file = input.files && input.files[0];
                if (!file) return;
                var reader = new FileReader();
                reader.onload = function (event) {
                    preview.innerHTML = "";
                    var img = document.createElement("img");
                    img.src = event.target.result;
                    img.alt = "";
                    preview.appendChild(img);
                    preview.classList.add("has-image");
                };
                reader.readAsDataURL(file);
                hint.textContent = file.name;
            });
        })();
    </script>
</body>
</html>
