<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <link rel="stylesheet" href="/public/stylesheets/intro.css">
    <title>회원가입</title>
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
    <link rel="stylesheet" href="/public/stylesheets/typography.css" />
</head>
<style>
    body{
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: flex-start;
    }
</style>
<body class="ui--light">
    <form action="/users/sign2" method="POST" enctype="multipart/form-data">
        <div class="sign_box" style="font-size: 30px; font-weight: 700;">
            <p onclick="console.log(window.location.pathname.split('/')[2])">추가 정보 입력</p>
            <input type="text" class="sign2_user_id" value="<%=user_id%>" readonly name="user_id">
        </div>
        <div style="width: 100%;height: 260px; margin-top: 50px; display: flex; flex-direction: column; justify-content: center; align-items: center;">
            <div id="image_container"></div> 
            <script> 
                if(document.querySelector('#image_container').children[0] == undefined){
                    function setThumbnail(event) { 
                        if(document.querySelector('#image_container').children[0] != undefined){
                            document.querySelector('#image_container').children[0].remove();
                        }
                        var reader = new FileReader(); reader.onload = function(event) { 
                        var img = document.createElement("img"); 
                        img.setAttribute("name",'img');
                        img.setAttribute("src", event.target.result); 
                        document.querySelector("div#image_container").appendChild(img); 
                    }; 
                    reader.readAsDataURL(event.target.files[0]);
                    }
                }
            </script>
        </div>
        <div class="sign_box" style="margin-top: 1vh;">
            <div class="filebox"> 
                <label for="ex_file" class="ui_btn">프로필 이미지 등록</label> 
                <input type="file" id="ex_file" accept="image/*" onchange="setThumbnail(event);" name="userfile"> 
            </div>
        </div>
        <div class="sign_box" style="margin-top: 1vh;">
            <input id="email" class="ui_input sign_box_input" type="text" placeholder="이메일" name="email">
        </div>
        <div class="sign_box" style="margin-top: 1vh;">
            <input id="age" class="ui_input sign_box_input" type="text" placeholder="출생년도" name="age">
        </div>
        <div class="sign_box" style="margin-top: 3vh;">
            <button class="ui_btn ui_btn--primary sign_submit_button">가입하기</button>
        </div>
    </form>
    <img src="/public/images/icon/exhibition_logo.svg" alt="EXHIBITION" style="position: fixed; top: 20px; left: 20px; z-index: 10; width: 240px; cursor: pointer;">
</body>
</html>