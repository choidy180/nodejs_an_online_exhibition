<%
    // 마이페이지 · 결제 (요금제 선택) — 메인 화면 스타일
    var plans = [
        { key: "basic", name: "베이직", count: 5, price: "45,900" },
        { key: "standard", name: "스탠다드", count: 10, price: "89,900" },
        { key: "premium", name: "프리미엄", count: 20, price: "169,900" }
    ];
    var current = String(sess.user.GRADE || "").toLowerCase();
    var hasCurrent = plans.some(function (plan) { return plan.key === current; });
    var selected = hasCurrent ? current : "basic";
%>
<main class="mp" aria-labelledby="mp_title">
    <%- include('mypage_head.ejs', { tab: 'payment' }) %>

    <section class="mp_section mp_section--first" aria-labelledby="my_plans_title">
        <h2 class="mp_section_title" id="my_plans_title">요금제<span class="mp_section_sub">한 달 기준 · 결제한 만큼 관람 가능 전시회 수가 늘어납니다</span></h2>
        <form class="my_plans_form" id="my_plans_form">
            <fieldset class="my_plans">
                <legend class="mp_sr_only">결제할 요금제</legend>
                <% plans.forEach(function (plan) { %>
                    <label class="my_plan_option">
                        <input class="mp_sr_only" type="radio" name="plan" value="<%= plan.key %>"<%= plan.key === selected ? " checked" : "" %>>
                        <span class="my_plan_option_head">
                            <span class="my_plan_option_name"><%= plan.name %></span>
                            <% if (plan.key === current) { %><span class="my_badge">이용 중</span><% } %>
                        </span>
                        <span class="my_plan_option_count"><strong><%= plan.count %></strong>관람 가능 전시회</span>
                        <span class="my_plan_option_price">₩<%= plan.price %><small> / 월</small></span>
                    </label>
                <% }) %>
            </fieldset>
            <div class="my_plans_foot">
                <p class="my_plans_choice">선택한 요금제 <strong id="my_plan_choice"><%= plans.filter(function (p) { return p.key === selected; })[0].name %></strong></p>
                <button type="submit" class="mp_button">다음</button>
            </div>
        </form>
    </section>
</main>
<script>
    (function () {
        var form = document.getElementById("my_plans_form");
        var choice = document.getElementById("my_plan_choice");
        if (!form) return;
        form.addEventListener("change", function (event) {
            if (event.target.name !== "plan") return;
            var name = event.target.closest(".my_plan_option").querySelector(".my_plan_option_name");
            choice.textContent = name.textContent;
        });
        // 다음: 고른 요금제의 결제 화면으로 (/payment_of_charges/basic 등)
        form.addEventListener("submit", function (event) {
            event.preventDefault();
            var picked = form.querySelector("input[name='plan']:checked");
            if (picked) location.href = "/payment_of_charges/" + encodeURIComponent(picked.value);
        });
    })();
</script>
